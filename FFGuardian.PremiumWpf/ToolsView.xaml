<UserControl x:Class="FFGuardian.PremiumWpf.ToolsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
 Foreground="{DynamicResource TextBrush}"
 Background="{DynamicResource BackgroundBrush}"
 automation:AutomationProperties.Name="Pagina Strumenti">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="24">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>

   <StackPanel Margin="0,0,0,18">
    <TextBlock Text="Strumenti" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
    <TextBlock Text="Controlla lo stato reale dei componenti di sicurezza e accedi agli strumenti diagnostici."
               Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap"/>
   </StackPanel>

   <Grid Grid.Row="1" Margin="0,0,0,18">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="1.18*" MinWidth="430"/>
     <ColumnDefinition Width="16"/>
     <ColumnDefinition Width="*" MinWidth="360"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Margin="0" Padding="26" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Width="60" Height="60" CornerRadius="18" Background="#193248" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" VerticalAlignment="Top">
       <Path Data="{StaticResource IconShield}" Stroke="{StaticResource WarningBrush}" StrokeThickness="1.8" Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Grid.Column="1">
       <TextBlock Text="STATO REALE" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
       <TextBlock Text="{Binding ProtectionText}" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,5,0,8" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding ProtectionDetail}" FontSize="14" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="680"/>
       <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
        <Button Style="{StaticResource PrimaryButton}" Content="Verifica strumenti" Command="{Binding RefreshCommand}"
                ToolTip="Esegue nuovamente i controlli runtime dei componenti" automation:AutomationProperties.Name="Verifica strumenti" MinWidth="166"/>
        <Button Style="{StaticResource SecondaryButton}" Content="Aggiorna stato" Command="{Binding RefreshCommand}" Margin="12,0,0,0"
                ToolTip="Aggiorna lo stato visualizzato" automation:AutomationProperties.Name="Aggiorna stato strumenti" MinWidth="145"/>
       </StackPanel>
       <TextBlock Text="{Binding LastAction}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap"/>
      </StackPanel>
     </Grid>
    </Border>

    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0" Padding="24" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}">
     <StackPanel>
      <TextBlock Text="Stato sistema" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
      <TextBlock Text="Esiti reali disponibili dall'ultimo controllo" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,14"/>
      <ItemsControl ItemsSource="{Binding Components}">
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,11">
          <Grid MinHeight="30">
           <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <Ellipse Width="10" Height="10" VerticalAlignment="Center">
            <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource WarningBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsOperational}" Value="True"><Setter Property="Fill" Value="{StaticResource AccentBrush}"/></DataTrigger><DataTrigger Binding="{Binding IsOperational}" Value="False"><Setter Property="Fill" Value="{StaticResource DangerBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
           </Ellipse>
           <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
           <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Verifica richiesta"/><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsOperational}" Value="True"><Setter Property="Text" Value="Operativo"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></DataTrigger><DataTrigger Binding="{Binding IsOperational}" Value="False"><Setter Property="Text" Value="Non operativo"/><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
           </TextBlock>
          </Grid>
         </Border>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
    </Border>
   </Grid>

   <StackPanel Grid.Row="2" Margin="0,0,0,10">
    <TextBlock Text="Componenti disponibili" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
    <ItemsControl ItemsSource="{Binding Components}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <Border Style="{StaticResource CardStyle}" Width="300" MinHeight="210" Margin="0,0,14,14" Padding="20" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}">
        <Grid>
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Width="40" Height="40" CornerRadius="12" Background="#183047"><Path Data="{StaticResource IconShield}" Stroke="{StaticResource InfoBrush}" StrokeThickness="1.7" Width="21" Height="21" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Ellipse Grid.Column="2" Width="10" Height="10" VerticalAlignment="Center"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource WarningBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsOperational}" Value="True"><Setter Property="Fill" Value="{StaticResource AccentBrush}"/></DataTrigger><DataTrigger Binding="{Binding IsOperational}" Value="False"><Setter Property="Fill" Value="{StaticResource DangerBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
         </Grid>
         <TextBlock Grid.Row="1" Text="Componente di rilevamento e protezione" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,14,0,8"/>
         <TextBlock Grid.Row="2" Text="{Binding Detail}" Foreground="{StaticResource TextBrush}" FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
         <Button Grid.Row="3" Style="{StaticResource GhostButton}" Content="Dettagli" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="security-center" HorizontalAlignment="Left" Margin="0,16,0,0"
                 ToolTip="Apri i dettagli nel Security Center" automation:AutomationProperties.Name="Dettagli componente"/>
        </Grid>
       </Border>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel>

   <StackPanel Grid.Row="3" Margin="0,4,0,16">
    <TextBlock Text="Azioni rapide" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
    <WrapPanel>
     <Button Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" Width="250" MinHeight="92" Margin="0,0,12,12" ToolTip="Esegue un nuovo controllo completo dei componenti" automation:AutomationProperties.Name="Self-test completo"><StackPanel HorizontalAlignment="Left"><TextBlock Text="Self-test completo" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Verifica nuovamente lo stato runtime" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Button>
     <Button Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" Width="250" MinHeight="92" Margin="0,0,12,12" ToolTip="Aggiorna lo stato dei componenti" automation:AutomationProperties.Name="Aggiorna componenti"><StackPanel HorizontalAlignment="Left"><TextBlock Text="Aggiorna componenti" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Rileggi versioni e disponibilità" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Button>
     <Button Style="{StaticResource GhostButton}" Click="OpenLogs_Click" Width="250" MinHeight="92" Margin="0,0,12,12" ToolTip="Apre la cartella locale dei log" automation:AutomationProperties.Name="Apri cartella log"><StackPanel HorizontalAlignment="Left"><TextBlock Text="Apri cartella log" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Consulta i report diagnostici locali" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Button>
     <Button Style="{StaticResource GhostButton}" Command="{Binding NavigateCommand}" CommandParameter="support" Width="250" MinHeight="92" Margin="0,0,12,12" ToolTip="Apri assistenza e diagnostica" automation:AutomationProperties.Name="Risoluzione problemi"><StackPanel HorizontalAlignment="Left"><TextBlock Text="Risoluzione problemi" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Apri assistenza e diagnostica" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Button>
    </WrapPanel>
   </StackPanel>

   <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0,0,0,24" Padding="18" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="Ultima verifica" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Text="{Binding LastUpdate}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock Text="Database firme" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Text="{Binding DatabaseVersion}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding DatabaseVersion}"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="Versione motori" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Text="{Binding EngineVersion}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding EngineVersion}"/></StackPanel>
     <StackPanel Grid.Column="3"><TextBlock Text="Licenza" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Text="Non disponibile" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
    </Grid>
   </Border>
  </Grid>
 </ScrollViewer>
</UserControl>