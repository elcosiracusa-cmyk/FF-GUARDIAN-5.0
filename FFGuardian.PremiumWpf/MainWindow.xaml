<Window x:Class="FFGuardian.PremiumWpf.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 mc:Ignorable="d" Title="FFGuardian Ultimate Protection"
 Width="1600" Height="960" MinWidth="1180" MinHeight="720"
 WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

  <Border Background="{StaticResource SidebarBrush}" BorderBrush="#1A2736" BorderThickness="0,0,1,0">
   <DockPanel>
    <Grid DockPanel.Dock="Top" Margin="24,22,24,18" Height="82">
     <Grid.ColumnDefinitions><ColumnDefinition Width="66"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Viewbox Width="58" Height="58">
      <Grid Width="64" Height="64">
       <Path Data="M32,3 L57,12 L54,39 C51,51 42,58 32,62 C22,58 13,51 10,39 L7,12 Z" Fill="#111D2A" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.4"/>
       <Path Data="M32,10 L49,16 L47,37 C44,45 39,50 32,54 C25,50 20,45 17,37 L15,16 Z" Fill="#0B111A" Stroke="#A9B6C7" StrokeThickness="1.2"/>
       <Path Data="M22,24 L31,31 L43,18 M22,38 L31,31 L42,43" Stroke="{StaticResource AccentBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
       <Ellipse Width="5" Height="5" Fill="White"/>
      </Grid>
     </Viewbox>
     <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
      <TextBlock Text="FFGUARDIAN" FontSize="23" FontWeight="Bold"/>
      <TextBlock Text="ULTIMATE PROTECTION" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
      <TextBlock Text="Versione 10.0.1" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
     </StackPanel>
    </Grid>

    <Border DockPanel.Dock="Bottom" Margin="18" Padding="18" CornerRadius="18" Background="#111B28" BorderBrush="#26364A" BorderThickness="1">
     <StackPanel><TextBlock Text="STATO PROTEZIONE" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Text="{Binding ProtectionText}" Foreground="{StaticResource AccentBrush}" FontSize="17" FontWeight="Bold"/><TextBlock Text="Determinato dai controlli runtime" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="0,0,0,14">
      <Button Style="{StaticResource NavButtonStyle}" Content="⌂   Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
      <Button Style="{StaticResource NavButtonStyle}" Content="◈   Protezione" Command="{Binding NavigateCommand}" CommandParameter="Protezione"/>
      <Button Style="{StaticResource NavButtonStyle}" Content="ϟ   Tempo Reale"/>
      <Button Style="{StaticResource NavButtonStyle}" Content="⌕   Scansione Rapida" Command="{Binding ActionCommand}" CommandParameter="Scansione Rapida"/>
      <Button Style="{StaticResource NavButtonStyle}" Content="▣   Scansione Completa" Command="{Binding ActionCommand}" CommandParameter="Scansione Completa"/>
      <Button Style="{StaticResource NavButtonStyle}" Content="□   Scansione Personalizzata" Command="{Binding ActionCommand}" CommandParameter="Scansione Cartella"/>
      <Button Style="{StaticResource NavButtonStyle}" Content="◆   Motori Antivirus"/>
      <Button Style="{StaticResource NavButtonStyle}" Content="▦   Firewall"/>
      <Button Style="{StaticResource NavButtonStyle}" Content="◉   Ransom Shield"/>
      <Button Style="{StaticResource NavButtonStyle}" Content="▰   USB Shield"/>
      <Button Style="{StaticResource NavButtonStyle}" Content="▱   Quarantena"/>
      <Button Style="{StaticResource NavButtonStyle}" Content="≡   Attività"/>
      <Button Style="{StaticResource NavButtonStyle}" Content="▥   Report"/>
      <Button Style="{StaticResource NavButtonStyle}" Content="↑   Aggiornamenti"/>
      <Button Style="{StaticResource NavButtonStyle}" Content="♡   Salute PC"/>
      <Button Style="{StaticResource NavButtonStyle}" Content="⌘   Strumenti"/>
      <Button Style="{StaticResource NavButtonStyle}" Content="⚙   Impostazioni"/>
      <Button Style="{StaticResource NavButtonStyle}" Content="?   Assistenza"/>
      <Button Style="{StaticResource NavButtonStyle}" Content="○   Account"/>
     </StackPanel>
    </ScrollViewer>
   </DockPanel>
  </Border>

  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="90"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Background="#0E141E" BorderBrush="#1E2A39" BorderThickness="0,0,0,1">
    <Grid Margin="28,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding SelectedPage}" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="FFGuardian Ultimate Protection" Foreground="{StaticResource MutedBrush}"/></StackPanel>
     <Border Grid.Column="1" Width="440" Height="48" HorizontalAlignment="Center" Background="#111A26" CornerRadius="14" BorderBrush="#2B3A4D" BorderThickness="1">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="⌕" Foreground="{StaticResource MutedBrush}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBox Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="15" VerticalContentAlignment="Center" ToolTip="Cerca impostazioni e attività"/></Grid>
     </Border>
     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Border Padding="12,8" Margin="0,0,10,0" CornerRadius="12" Background="#112219" BorderBrush="#265C38" BorderThickness="1"><StackPanel Orientation="Horizontal"><TextBlock Text="●" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/><TextBlock Text="{Binding ProtectionText}" FontWeight="SemiBold"/></StackPanel></Border><Button Style="{StaticResource IconButtonStyle}" Content="↻" Command="{Binding RefreshCommand}" ToolTip="Aggiorna"/><Button Style="{StaticResource IconButtonStyle}" Content="♢" ToolTip="Notifiche"/><Button Style="{StaticResource IconButtonStyle}" Content="◐" ToolTip="Tema"/><Button Style="{StaticResource IconButtonStyle}" Content="○" ToolTip="Profilo"/></StackPanel>
    </Grid>
   </Border>

   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,24,24,34">
     <Border Style="{StaticResource GlassCardStyle}" Padding="34">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
       <Grid Width="350" Height="350"><Ellipse Stroke="#223247" StrokeThickness="22"/><Ellipse Stroke="{StaticResource AccentBrush}" StrokeThickness="22" StrokeDashArray="3,0.55" RenderTransformOrigin=".5,.5" Effect="{StaticResource GreenGlow}"><Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform></Ellipse><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding SecurityScore}" FontSize="88" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="SECURITY SCORE" Foreground="{StaticResource MutedBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="su 100" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel></Grid>
       <StackPanel Grid.Column="1" Margin="32,28" VerticalAlignment="Center"><TextBlock Text="STATO DELLA PROTEZIONE" Foreground="{StaticResource MutedBrush}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding ProtectionText}" Foreground="{StaticResource AccentBrush}" FontSize="48" FontWeight="Bold" Margin="0,10,0,12"/><TextBlock Text="{Binding ProtectionDetail}" Foreground="{StaticResource MutedBrush}" FontSize="18" LineHeight="28" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,26,0,0"><Button Style="{StaticResource ActionButtonStyle}" Content="Avvia scansione rapida" Command="{Binding ActionCommand}" CommandParameter="Scansione Rapida"/><Button Style="{StaticResource NavButtonStyle}" Content="Dettagli protezione  →" Command="{Binding NavigateCommand}" CommandParameter="Protezione" Margin="12,0,0,0"/></StackPanel></StackPanel>
       <Border Grid.Column="2" Background="#0D1520" CornerRadius="18" Padding="22" BorderBrush="#26364A" BorderThickness="1"><StackPanel VerticalAlignment="Center"><TextBlock Text="RIEPILOGO SISTEMA" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,18"/><TextBlock Text="Ultima scansione" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding LastScan}" FontSize="16" Margin="0,3,0,15"/><TextBlock Text="Aggiornamento firme" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding LastUpdate}" FontSize="16" Margin="0,3,0,15"/><TextBlock Text="Versione motore" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding EngineVersion}" FontSize="16" Margin="0,3,0,15"/><TextBlock Text="Versione database" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding DatabaseVersion}" FontSize="16" Margin="0,3,0,0"/></StackPanel></Border>
      </Grid>
     </Border>

     <WrapPanel Margin="0,14,0,0" ItemWidth="300" ItemHeight="205">
      <Border Style="{StaticResource CardStyle}" Width="300" Height="190"><StackPanel><TextBlock Text="⌕" Foreground="{StaticResource AccentBrush}" FontSize="36"/><TextBlock Text="Scansione Rapida" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,4"/><TextBlock Text="Controlla le aree sensibili" Foreground="{StaticResource MutedBrush}"/><Button Style="{StaticResource ActionButtonStyle}" Content="Avvia" Margin="0,18,0,0" Command="{Binding ActionCommand}" CommandParameter="Scansione Rapida"/></StackPanel></Border>
      <Border Style="{StaticResource CardStyle}" Width="300" Height="190"><StackPanel><TextBlock Text="▣" Foreground="{StaticResource AccentBrush}" FontSize="36"/><TextBlock Text="Scansione Completa" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,4"/><TextBlock Text="Analisi profonda di unità e file" Foreground="{StaticResource MutedBrush}"/><Button Style="{StaticResource ActionButtonStyle}" Content="Avvia" Margin="0,18,0,0" Command="{Binding ActionCommand}" CommandParameter="Scansione Completa"/></StackPanel></Border>
      <Border Style="{StaticResource CardStyle}" Width="300" Height="190"><StackPanel><TextBlock Text="□" Foreground="{StaticResource AccentBrush}" FontSize="36"/><TextBlock Text="Personalizzata" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,4"/><TextBlock Text="Scegli file, cartella o unità" Foreground="{StaticResource MutedBrush}"/><Button Style="{StaticResource ActionButtonStyle}" Content="Seleziona" Margin="0,18,0,0" Command="{Binding ActionCommand}" CommandParameter="Scansione Cartella"/></StackPanel></Border>
      <Border Style="{StaticResource CardStyle}" Width="300" Height="190"><StackPanel><TextBlock Text="↑" Foreground="{StaticResource AccentBrush}" FontSize="36"/><TextBlock Text="Aggiorna Database" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,4"/><TextBlock Text="Aggiorna firme e stato motori" Foreground="{StaticResource MutedBrush}"/><Button Style="{StaticResource ActionButtonStyle}" Content="Aggiorna" Margin="0,18,0,0" Command="{Binding RefreshCommand}"/></StackPanel></Border>
     </WrapPanel>

     <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="MOTORI ANTIVIRUS" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/><ItemsControl ItemsSource="{Binding Components}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#101925" CornerRadius="14" Padding="16" Margin="0,5" BorderBrush="#26364A" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="9" Background="#142B1C"><TextBlock Text="◆" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="ATTIVITÀ RECENTI" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/><ItemsControl ItemsSource="{Binding Activities}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0"/><Border Grid.Column="1" BorderBrush="#26364A" BorderThickness="0,0,0,1" Padding="0,0,0,13"><TextBlock Text="{Binding}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></Border></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
     </Grid>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </Grid>
</Window>