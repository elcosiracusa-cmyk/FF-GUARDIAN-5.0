<Window x:Class="FFGuardian.PremiumWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FFGuardian Ultimate Protection"
        Width="1600" Height="960"
        MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Grid Background="{StaticResource BackgroundBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- SIDEBAR -->
    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#1A2736" BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="True">
        <Grid DockPanel.Dock="Top" Margin="24,22,24,20" Height="82">
          <Grid.ColumnDefinitions><ColumnDefinition Width="66"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Viewbox Width="58" Height="58" VerticalAlignment="Center">
            <Grid Width="64" Height="64">
              <Path Data="M32,3 L57,12 L54,39 C51,51 42,58 32,62 C22,58 13,51 10,39 L7,12 Z"
                    Fill="#111D2A" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.4"/>
              <Path Data="M32,10 L49,16 L47,37 C44,45 39,50 32,54 C25,50 20,45 17,37 L15,16 Z"
                    Fill="#0B111A" Stroke="#A9B6C7" StrokeThickness="1.2" Opacity="0.9"/>
              <Path Data="M22,24 L31,31 L43,18 M22,38 L31,31 L42,43"
                    Stroke="{StaticResource AccentBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Ellipse Width="5" Height="5" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </Viewbox>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
            <TextBlock Text="FFGUARDIAN" FontSize="23" FontWeight="Bold" LetterSpacing="1"/>
            <TextBlock Text="ULTIMATE PROTECTION" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" LetterSpacing="2"/>
            <TextBlock Text="Versione 10.0.1" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
          </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Bottom" Margin="18" Padding="18" CornerRadius="18" Background="#111B28" BorderBrush="#26364A" BorderThickness="1">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Viewbox Width="34" Height="34">
              <Path Data="M12,1 L22,5 L21,15 C20,20 16,23 12,25 C8,23 4,20 3,15 L2,5 Z M7,12 L11,16 L18,8"
                    Fill="Transparent" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"/>
            </Viewbox>
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
              <TextBlock Text="STATO PROTEZIONE" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
              <TextBlock Text="{Binding ProtectionText}" Foreground="{StaticResource AccentBrush}" FontSize="17" FontWeight="Bold" Margin="0,2,0,0"/>
              <TextBlock Text="Controlli runtime verificati" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
          </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,0,14">
            <Button Style="{StaticResource NavButtonStyle}" Content="⌂   Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
            <Button Style="{StaticResource NavButtonStyle}" Content="◈   Protezione" Command="{Binding NavigateCommand}" CommandParameter="Protezione"/>
            <Button Style="{StaticResource NavButtonStyle}" Content="ϟ   Tempo Reale"/>
            <Button Style="{StaticResource NavButtonStyle}" Content="⌕   Scansione Rapida" Command="{Binding ActionCommand}" CommandParameter="Scansione Rapida"/>
            <Button Style="{StaticResource NavButtonStyle}" Content="▣   Scansione Completa" Command="{Binding ActionCommand}" CommandParameter="Scansione Completa"/>
            <Button Style="{StaticResource NavButtonStyle}" Content="□   Scansione Personalizzata" Command="{Binding ActionCommand}" CommandParameter="Scansione Cartella"/>
            <Button Style="{StaticResource NavButtonStyle}" Content="◆   Motori Antivirus"/>
            <Button Style="{StaticResource NavButtonStyle}" Content="▦   Firewall"/>
            <Button Style="{StaticResource NavButtonStyle}" Content="◉   Ransom Shield"/>
            <Button Style="{StaticResource NavButtonStyle}" Content="▰   USB Shield"/>
            <Button Style="{StaticResource NavButtonStyle}" Content="▱   Quarantena"/>
            <Button Style="{StaticResource NavButtonStyle}" Content="≡   Attività"/>
            <Button Style="{StaticResource NavButtonStyle}" Content="▥   Report"/>
            <Button Style="{StaticResource NavButtonStyle}" Content="↑   Aggiornamenti"/>
            <Button Style="{StaticResource NavButtonStyle}" Content="♡   Salute PC"/>
            <Button Style="{StaticResource NavButtonStyle}" Content="⌘   Strumenti"/>
            <Button Style="{StaticResource NavButtonStyle}" Content="⚙   Impostazioni"/>
            <Button Style="{StaticResource NavButtonStyle}" Content="?   Assistenza"/>
            <Button Style="{StaticResource NavButtonStyle}" Content="○   Account"/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- MAIN CONTENT -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="90"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <Border Grid.Row="0" Background="#0E141E" BorderBrush="#1E2A39" BorderThickness="0,0,0,1">
        <Grid Margin="28,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectedPage}" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="FFGuardian Ultimate Protection" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
          </StackPanel>
          <Border Grid.Column="1" Width="440" MaxWidth="520" Height="48" HorizontalAlignment="Center" Background="#111A26" CornerRadius="14" BorderBrush="#2B3A4D" BorderThickness="1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="⌕" Foreground="{StaticResource MutedBrush}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <TextBox Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="15" VerticalContentAlignment="Center" Padding="0,0,14,0" ToolTip="Cerca impostazioni, attività e strumenti"/>
            </Grid>
          </Border>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Padding="12,8" Margin="0,0,10,0" CornerRadius="12" Background="#112219" BorderBrush="#265C38" BorderThickness="1">
              <StackPanel Orientation="Horizontal"><TextBlock Text="●" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/><TextBlock Text="{Binding ProtectionText}" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Button Style="{StaticResource IconButtonStyle}" Content="↻" Command="{Binding RefreshCommand}" ToolTip="Aggiorna stato"/>
            <Button Style="{StaticResource IconButtonStyle}" Content="♢" ToolTip="Notifiche"/>
            <Button Style="{StaticResource IconButtonStyle}" Content="◐" ToolTip="Tema"/>
            <Button Style="{StaticResource IconButtonStyle}" Content="○" ToolTip="Profilo"/>
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,24,24,34">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- HERO -->
          <Border Grid.Row="0" Style="{StaticResource GlassCardStyle}" Padding="34">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="440"/><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
              <Grid Width="390" Height="390" HorizontalAlignment="Center">
                <Ellipse Stroke="#223247" StrokeThickness="24"/>
                <Ellipse Stroke="{StaticResource AccentBrush}" StrokeThickness="24" StrokeDashArray="3,0.55" RenderTransformOrigin=".5,.5" Effect="{StaticResource GreenGlow}">
                  <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                </Ellipse>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding SecurityScore}" FontSize="96" FontWeight="Bold" HorizontalAlignment="Center"/>
                  <TextBlock Text="SECURITY SCORE" Foreground="{StaticResource MutedBrush}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" LetterSpacing="2"/>
                  <TextBlock Text="su 100" Foreground="{StaticResource AccentBrush}" FontSize="15" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
              </Grid>

              <StackPanel Grid.Column="1" Margin="34,30" VerticalAlignment="Center">
                <TextBlock Text="STATO DELLA PROTEZIONE" Foreground="{StaticResource MutedBrush}" FontSize="14" FontWeight="SemiBold" LetterSpacing="2"/>
                <TextBlock Text="{Binding ProtectionText}" Foreground="{StaticResource AccentBrush}" FontSize="52" FontWeight="Bold" Margin="0,10,0,12"/>
                <TextBlock Text="{Binding ProtectionDetail}" Foreground="{StaticResource MutedBrush}" FontSize="18" LineHeight="28" TextWrapping="Wrap" MaxWidth="650"/>
                <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                  <Button Style="{StaticResource ActionButtonStyle}" Content="Avvia scansione rapida" Command="{Binding ActionCommand}" CommandParameter="Scansione Rapida" MinWidth="220"/>
                  <Button Style="{StaticResource NavButtonStyle}" Content="Dettagli protezione  →" Command="{Binding NavigateCommand}" CommandParameter="Protezione" Margin="14,0,0,0"/>
                </StackPanel>
              </StackPanel>

              <Border Grid.Column="2" Background="#0D1520" CornerRadius="18" Padding="24" BorderBrush="#26364A" BorderThickness="1">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="RIEPILOGO SISTEMA" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,20"/>
                  <TextBlock Text="Ultima scansione" Foreground="{StaticResource MutedBrush}" FontSize="13"/><TextBlock Text="{Binding LastScan}" FontSize="17" Margin="0,4,0,18"/>
                  <TextBlock Text="Aggiornamento firme" Foreground="{StaticResource MutedBrush}" FontSize="13"/><TextBlock Text="{Binding LastUpdate}" FontSize="17" Margin="0,4,0,18"/>
                  <TextBlock Text="Versione motore" Foreground="{StaticResource MutedBrush}" FontSize="13"/><TextBlock Text="{Binding EngineVersion}" FontSize="17" Margin="0,4,0,18"/>
                  <TextBlock Text="Versione database" Foreground="{StaticResource MutedBrush}" FontSize="13"/><TextBlock Text="{Binding DatabaseVersion}" FontSize="17" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <!-- PRIMARY ACTIONS -->
          <WrapPanel Grid.Row="1" Margin="0,14,0,0" ItemWidth="300" ItemHeight="210">
            <Border Style="{StaticResource CardStyle}" Width="300" Height="194"><StackPanel><TextBlock Text="⌕" Foreground="{StaticResource AccentBrush}" FontSize="38"/><TextBlock Text="Scansione Rapida" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,4"/><TextBlock Text="Controlla le aree più sensibili" Foreground="{StaticResource MutedBrush}" FontSize="14"/><Button Style="{StaticResource ActionButtonStyle}" Content="Avvia" Margin="0,20,0,0" Command="{Binding ActionCommand}" CommandParameter="Scansione Rapida"/></StackPanel></Border>
            <Border Style="{StaticResource CardStyle}" Width="300" Height="194"><StackPanel><TextBlock Text="▣" Foreground="{StaticResource AccentBrush}" FontSize="38"/><TextBlock Text="Scansione Completa" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,4"/><TextBlock Text="Analisi profonda di unità e file" Foreground="{StaticResource MutedBrush}" FontSize="14"/><Button Style="{StaticResource ActionButtonStyle}" Content="Avvia" Margin="0,20,0,0" Command="{Binding ActionCommand}" CommandParameter="Scansione Completa"/></StackPanel></Border>
            <Border Style="{StaticResource CardStyle}" Width="300" Height="194"><StackPanel><TextBlock Text="□" Foreground="{StaticResource AccentBrush}" FontSize="38"/><TextBlock Text="Personalizzata" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,4"/><TextBlock Text="Scegli file, cartella o unità" Foreground="{StaticResource MutedBrush}" FontSize="14"/><Button Style="{StaticResource ActionButtonStyle}" Content="Seleziona" Margin="0,20,0,0" Command="{Binding ActionCommand}" CommandParameter="Scansione Cartella"/></StackPanel></Border>
            <Border Style="{StaticResource CardStyle}" Width="300" Height="194"><StackPanel><TextBlock Text="↑" Foreground="{StaticResource AccentBrush}" FontSize="38"/><TextBlock Text="Aggiorna Database" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,4"/><TextBlock Text="Mantieni firme e motori aggiornati" Foreground="{StaticResource MutedBrush}" FontSize="14"/><Button Style="{StaticResource ActionButtonStyle}" Content="Aggiorna" Margin="0,20,0,0" Command="{Binding RefreshCommand}"/></StackPanel></Border>
          </WrapPanel>

          <!-- ENGINES AND ACTIVITY -->
          <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <DockPanel Margin="0,0,0,18"><TextBlock Text="MOTORI ANTIVIRUS" FontSize="22" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" Style="{StaticResource NavButtonStyle}" Content="Apri centro motori  →"/></DockPanel>
                <ItemsControl ItemsSource="{Binding Components}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#101925" CornerRadius="14" Padding="16" Margin="0,5" BorderBrush="#26364A" BorderThickness="1">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <Border Width="34" Height="34" CornerRadius="9" Background="#142B1C"><TextBlock Text="◆" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                          <StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="12"/></StackPanel>
                          <Border Grid.Column="2" Padding="10,5" CornerRadius="9" Background="#142B1C"><TextBlock Text="VERIFICATO" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/></Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="ATTIVITÀ RECENTI" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/>
                <ItemsControl ItemsSource="{Binding Activities}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"/>
                        <Border Grid.Column="1" BorderBrush="#26364A" BorderThickness="0,0,0,1" Padding="0,0,0,14"><TextBlock Text="{Binding}" Foreground="{StaticResource MutedBrush}" FontSize="14" TextWrapping="Wrap"/></Border>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Grid>

          <!-- SYSTEM MONITOR -->
          <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="8,22,8,8">
            <StackPanel>
              <TextBlock Text="MONITOR SISTEMA" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/>
              <UniformGrid Columns="4">
                <Border Background="#101925" CornerRadius="14" Padding="18" Margin="6"><StackPanel><TextBlock Text="CPU" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Monitoraggio disponibile" FontSize="16" Margin="0,8,0,12"/><ProgressBar Value="42" Height="7" Foreground="{StaticResource AccentBrush}" Background="#26364A"/></StackPanel></Border>
                <Border Background="#101925" CornerRadius="14" Padding="18" Margin="6"><StackPanel><TextBlock Text="RAM" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Utilizzo memoria" FontSize="16" Margin="0,8,0,12"/><ProgressBar Value="58" Height="7" Foreground="{StaticResource AccentBrush}" Background="#26364A"/></StackPanel></Border>
                <Border Background="#101925" CornerRadius="14" Padding="18" Margin="6"><StackPanel><TextBlock Text="DISCO" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Attività unità" FontSize="16" Margin="0,8,0,12"/><ProgressBar Value="31" Height="7" Foreground="{StaticResource AccentBrush}" Background="#26364A"/></StackPanel></Border>
                <Border Background="#101925" CornerRadius="14" Padding="18" Margin="6"><StackPanel><TextBlock Text="RETE" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Traffico protetto" FontSize="16" Margin="0,8,0,12"/><ProgressBar Value="67" Height="7" Foreground="{StaticResource AccentBrush}" Background="#26364A"/></StackPanel></Border>
              </UniformGrid>
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>