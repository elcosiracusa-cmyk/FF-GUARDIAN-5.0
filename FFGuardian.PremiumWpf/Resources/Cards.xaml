<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="{StaticResource CardBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="8"/><Setter Property="SnapsToDevicePixels" Value="True"/></Style>
 <Style x:Key="GlassCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}"><Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F20E1C2D" Offset="0"/><GradientStop Color="#E60B1727" Offset="1"/></LinearGradientBrush></Setter.Value></Setter><Setter Property="CornerRadius" Value="20"/></Style>
 <Style x:Key="StatusChipStyle" TargetType="Border"><Setter Property="Background" Value="#183225"/><Setter Property="BorderBrush" Value="#2F7250"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="10,6"/></Style>
</ResourceDictionary>