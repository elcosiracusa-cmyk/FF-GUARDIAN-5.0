<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Color x:Key="BackgroundColor">#07111F</Color><Color x:Key="SidebarColor">#0A1626</Color><Color x:Key="CardColor">#0E1C2D</Color><Color x:Key="CardHoverColor">#14263A</Color><Color x:Key="BorderColor">#24384D</Color><Color x:Key="TextColor">#F2F6FA</Color><Color x:Key="MutedColor">#A9B7C6</Color><Color x:Key="SuccessColor">#43F57A</Color><Color x:Key="InfoColor">#38BDF8</Color><Color x:Key="PurpleColor">#A855F7</Color><Color x:Key="WarningColor">#F5B942</Color><Color x:Key="DangerColor">#FF5A67</Color>
