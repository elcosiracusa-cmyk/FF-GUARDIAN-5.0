<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BackgroundColor">#071019</Color>
    <Color x:Key="SidebarColor">#0A1420</Color>
    <Color x:Key="CardColor">#101D2A</Color>
    <Color x:Key="CardHoverColor">#17283A</Color>
    <Color x:Key="BorderColor">#294158</Color>
    <Color x:Key="TextColor">#F7FAFC</Color>
    <Color x:Key="MutedColor">#AAB9C8</Color>
    <Color x:Key="DisabledTextColor">#617386</Color>
    <Color x:Key="SuccessColor">#45E08C</Color>
    <Color x:Key="InfoColor">#55AFFF</Color>
    <Color x:Key="PurpleColor">#A77BFF</Color>
    <Color x:Key="WarningColor">#F5C451</Color>
    <Color x:Key="DangerColor">#FF6875</Color>
    <Color x:Key="SurfaceElevatedColor">#152536</Color>
    <Color x:Key="SeparatorColor">#1D3348</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource SeparatorColor}"/>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#63E6A1" Offset="0"/>
        <GradientStop Color="#2FC978" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="InfoGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6EC1FF" Offset="0"/>
        <GradientStop Color="#3D8FF0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF142333" Offset="0"/>
        <GradientStop Color="#FF0D1824" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="OverlayBrush" Color="#99050B11"/>
</ResourceDictionary>