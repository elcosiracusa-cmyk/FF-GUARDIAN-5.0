<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FFGuardian</AssemblyName>
    <RootNamespace>FFGuardian</RootNamespace>
    <Version>8.2.2</Version>
    <FileVersion>8.2.2.0</FileVersion>
    <AssemblyVersion>8.2.2.0</AssemblyVersion>
    <Company>EL.CO di Francesco Fazzina</Company>
    <Product>FF GUARDIAN 8.2.2 Core Cleanup and Performance</Product>
    <Description>Personal Security Suite Cloud Ready con coordinatore UI adattivo, minore lavoro ripetuto, salvataggi atomici, rotazione log, istanza singola e maggiore fluidità</Description>
    <Copyright>Copyright © EL.CO 2026</Copyright>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon Condition="Exists('Assets\dobermann.ico')">Assets\dobermann.ico</ApplicationIcon>
  </PropertyGroup>
</Project>