<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FFGuardian</AssemblyName>
    <RootNamespace>FFGuardian</RootNamespace>
    <Version>6.0.0</Version>
    <FileVersion>6.0.0.0</FileVersion>
    <AssemblyVersion>6.0.0.0</AssemblyVersion>
    <Company>EL.CO di Francesco Fazzina</Company>
    <Product>FF GUARDIAN 6.0 Advanced Autonomous Security Engine</Product>
    <Description>Personal Security Suite avanzata con profili, controllo Download, punteggio dinamico, Proteggi adesso e automazione persistente</Description>
    <Copyright>Copyright © EL.CO 2026</Copyright>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
</Project>