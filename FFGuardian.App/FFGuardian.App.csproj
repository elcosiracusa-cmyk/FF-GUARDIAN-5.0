<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FFGuardian</AssemblyName>
    <RootNamespace>FFGuardian</RootNamespace>
    <Version>5.4.0</Version>
    <FileVersion>5.4.0.0</FileVersion>
    <AssemblyVersion>5.4.0.0</AssemblyVersion>
    <Company>EL.CO di Francesco Fazzina</Company>
    <Product>FF GUARDIAN 5.4 Autonomous Security Engine</Product>
    <Description>Personal Security Suite con monitoraggio autonomo, aggiornamento firme programmato, scansioni settimanali e cronologia persistente</Description>
    <Copyright>Copyright © EL.CO 2026</Copyright>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
</Project>