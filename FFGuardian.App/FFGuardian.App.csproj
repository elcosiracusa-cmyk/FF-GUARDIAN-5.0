<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FFGuardian</AssemblyName>
    <RootNamespace>FFGuardian</RootNamespace>
    <Version>5.0.2</Version>
    <FileVersion>5.0.2.0</FileVersion>
    <AssemblyVersion>5.0.2.0</AssemblyVersion>
    <Company>EL.CO di Francesco Fazzina</Company>
    <Product>FF GUARDIAN 5.0.2 Navigation &amp; Tools Fix</Product>
    <Description>Next Gen Security Suite per Microsoft Defender e Windows</Description>
    <Copyright>Copyright © EL.CO 2026</Copyright>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
</Project>