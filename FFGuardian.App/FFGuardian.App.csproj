<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FFGuardian</AssemblyName>
    <RootNamespace>FFGuardian</RootNamespace>
    <Version>8.2.0</Version>
    <FileVersion>8.2.0.0</FileVersion>
    <AssemblyVersion>8.2.0.0</AssemblyVersion>
    <Company>EL.CO di Francesco Fazzina</Company>
    <Product>FF GUARDIAN 8.2 Stability and Protection Upgrade</Product>
    <Description>Personal Security Suite Cloud Ready con coordinatore UI stabile, istanza singola, gestione errori protetta, impostazioni avanzate e motore autonomo locale</Description>
    <Copyright>Copyright © EL.CO 2026</Copyright>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon Condition="Exists('Assets\dobermann.ico')">Assets\dobermann.ico</ApplicationIcon>
  </PropertyGroup>
</Project>