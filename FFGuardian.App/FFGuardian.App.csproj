<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <AssemblyName>FFGuardian</AssemblyName>
    <RootNamespace>FFGuardian</RootNamespace>
    <Version>10.0.1-rc.1</Version>
    <FileVersion>10.0.1.1</FileVersion>
    <AssemblyVersion>10.0.1.0</AssemblyVersion>
    <Company>EL.CO — by FFsoftware</Company>
    <Product>FF GUARDIAN 10.0.1 RC1 — EL.CO by FFsoftware</Product>
    <Description>Motore di sicurezza indipendente creato da EL.CO by FFsoftware, con protezione continua user-mode, audit, scansione statica, SHA-256, Authenticode, quarantena cifrata, rollback, ClamAV, YARA reale, aggiornamenti firmati e assistenza su alsafe127.00@gmail.com</Description>
    <Copyright>Copyright © EL.CO — FFsoftware 2026</Copyright>
    <ApplicationIcon Condition="Exists('Assets\dobermann.ico')">Assets\dobermann.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Engine10TestBuild)' != 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Engine10TestBuild)' == 'true'">
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Rules\**\*.yar">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Rules\**\*.yara">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="MainForm.cs" />
    <Compile Remove="CleanMainForm90.cs" />
    <Compile Remove="ProfessionalMainForm91.cs" />
    <Compile Remove="ProfessionalMainForm92.cs" />
    <Compile Remove="AutonomousProtectionContext.cs" />
    <Compile Remove="AutonomousSecurityEngine.cs" />
    <Compile Remove="SecurityOperationGate92.cs" />
    <Compile Remove="LayoutRepair.cs" />
    <Compile Remove="StatusInnovationFix.cs" />
    <Compile Remove="SupportEmailLayoutFix.cs" />
    <Compile Remove="SupportVisibilityPatch.cs" />
    <Compile Remove="Advanced60Ui.cs" />
    <Compile Remove="Version60Fix.cs" />
    <Compile Remove="UiReadabilityFix.cs" />
    <Compile Remove="ProfessionalSecurityCenter63.cs" />
    <Compile Remove="SidebarFirewallFix631.cs" />
    <Compile Remove="CloudReady80.cs" />
    <Compile Remove="AdvancedSettings81.cs" />
    <Compile Remove="CoreHealth83.cs" />
    <Compile Remove="InterfaceRecovery831.cs" />
    <Compile Remove="DefinitiveReports832.cs" />
    <Compile Remove="FinalUiAudit834.cs" />
    <Compile Remove="DeepBugDiagnostics835.cs" />
    <Compile Remove="VersionConsistency836.cs" />
    <Compile Remove="PremiumNeonUi86.cs" />
    <!-- La versione Safe sostituisce la dashboard precedente per evitare trasparenze WinForms non supportate. -->
    <Compile Remove="UltimateDashboardExperience10.cs" />
  </ItemGroup>
</Project>
